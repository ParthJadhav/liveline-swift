{
  "name": "liveline-platforms-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion source for Liveline Swift release and cross-platform demo videos",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render LivelinePlatforms ../Media/liveline-platforms.mp4",
    "render:060": "remotion render Liveline060 ../Media/liveline-0-6-0-demo.mp4",
