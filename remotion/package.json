    "render:advanced-pr": "remotion render LivelineAdvancedPR ../Media/liveline-advanced-charts-pr.mp4 --concurrency=4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/transitions": "4.0.507",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.17"
  }
}
